diff --git a/src/poly/stage_copy.hpp b/src/poly/stage_copy.hpp
new file mode 100644
index 00000000..d42b35d9
--- /dev/null
+++ b/src/poly/stage_copy.hpp
@@ -0,0 +1,83 @@
+// Non-overlapping CPU copies into upload-only buffers. The caller publishes task completion after this returns.
+// Keep this internal to expert staging: streaming stores help when the CPU will not read the destination next.
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#if defined(__SSE2__) || defined(_M_X64) || (defined(_M_IX86_FP) && _M_IX86_FP >= 2)
+#include <emmintrin.h>
+#endif
+
+namespace strata::poly {
+inline constexpr bool stage_copy_streaming_available() {
+#if defined(__SSE2__) || defined(_M_X64) || (defined(_M_IX86_FP) && _M_IX86_FP >= 2)
+    return true;
+#else
+    return false;
+#endif
+}
+
+inline void stage_copy_streaming(void* destination, const void* source, size_t bytes) {
+#if defined(__SSE2__) || defined(_M_X64) || (defined(_M_IX86_FP) && _M_IX86_FP >= 2)
+    // Whole 64-byte lines avoid mixing ordinary and streaming stores within a
+    // cache line on the measured x86 hosts. The 4 KiB cutoff is a conservative
+    // small-copy fallback, not a CPU-specific crossover established by tuning.
+    // Two lines per iteration is only an unrolling choice; SSE2 stores need 16-byte alignment.
+    constexpr size_t kCacheLineBytes = 64;
+    constexpr size_t kStreamingMinBytes = 4096;
+    constexpr size_t kBlockBytes = 2 * kCacheLineBytes;
+    if (bytes < kStreamingMinBytes) {
+        std::memcpy(destination, source, bytes);
+        return;
+    }
+    auto* d = static_cast<unsigned char*>(destination);
+    auto* s = static_cast<const unsigned char*>(source);
+    // Leave partial cache lines to ordinary stores; do not mix them with streaming stores in the same line.
+    const size_t misalignment = reinterpret_cast<uintptr_t>(d) & (kCacheLineBytes - 1);
+    const size_t head = (std::min)(bytes, (kCacheLineBytes - misalignment) & (kCacheLineBytes - 1));
+    if (head) {
+        std::memcpy(d, s, head);
+        d += head;
+        s += head;
+        bytes -= head;
+    }
+    while (bytes >= kBlockBytes) {
+        const auto v0 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(s));
+        const auto v1 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 16));
+        const auto v2 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 32));
+        const auto v3 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 48));
+        const auto v4 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 64));
+        const auto v5 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 80));
+        const auto v6 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 96));
+        const auto v7 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 112));
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d), v0);
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 16), v1);
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 32), v2);
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 48), v3);
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 64), v4);
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 80), v5);
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 96), v6);
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 112), v7);
+        d += kBlockBytes;
+        s += kBlockBytes;
+        bytes -= kBlockBytes;
+    }
+    if (bytes >= kCacheLineBytes) {
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d), _mm_loadu_si128(reinterpret_cast<const __m128i*>(s)));
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 16), _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 16)));
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 32), _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 32)));
+        _mm_stream_si128(reinterpret_cast<__m128i*>(d + 48), _mm_loadu_si128(reinterpret_cast<const __m128i*>(s + 48)));
+        d += kCacheLineBytes;
+        s += kCacheLineBytes;
+        bytes -= kCacheLineBytes;
+    }
+    if (bytes) std::memcpy(d, s, bytes);
+    // Drain this worker's streaming stores before it publishes task completion.
+    // A fence on the coordinator thread would not drain the other workers' stores.
+    _mm_sfence();
+#else
+    std::memcpy(destination, source, bytes);
+#endif
+}
+} // namespace strata::poly
diff --git a/src/poly/stage_copy_test.cpp b/src/poly/stage_copy_test.cpp
new file mode 100644
index 00000000..78119fe5
--- /dev/null
+++ b/src/poly/stage_copy_test.cpp
@@ -0,0 +1,139 @@
+#include "stage_copy.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#if defined(_WIN32)
+#define NOMINMAX
+#include <windows.h>
+#elif defined(__unix__) || defined(__APPLE__)
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+namespace {
+constexpr size_t kAlignment = 64;
+constexpr unsigned char kGuard = 0xd3;
+
+unsigned char* aligned(std::vector<unsigned char>& storage) {
+    const auto address = reinterpret_cast<uintptr_t>(storage.data());
+    return reinterpret_cast<unsigned char*>((address + kAlignment - 1) & ~(uintptr_t(kAlignment) - 1));
+}
+
+void check(bool ok, size_t n, size_t from, size_t to) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL n=%zu src=%zu dst=%zu\n", n, from, to);
+    std::exit(1);
+}
+
+// Guard bytes catch writes outside the destination. Explicit alignment makes each
+// offset an actual cache-line residue, independent of the allocator's alignment.
+size_t check_offsets(size_t n, size_t step) {
+    std::vector<unsigned char> source(n + 4 * kAlignment), destination(source.size());
+    auto* s = aligned(source) + kAlignment;
+    auto* d = aligned(destination) + kAlignment;
+    for (size_t i = 0; i < source.size(); ++i) source[i] = (i * 37 + n) % 251;
+    const auto before = source;
+    size_t cases = 0;
+    for (size_t from = 0; from < kAlignment; from += step) {
+        for (size_t to = 0; to < kAlignment; to += step) {
+            std::fill(destination.begin(), destination.end(), kGuard);
+            auto expected = destination;
+            std::copy_n(s + from, n, expected.data() + (d - destination.data()) + to);
+            strata::poly::stage_copy_streaming(d + to, s + from, n);
+            check(destination == expected && source == before, n, from, to);
+            ++cases;
+        }
+    }
+    return cases;
+}
+
+#if defined(_WIN32) || defined(__unix__) || defined(__APPLE__)
+// A readable guard byte cannot detect an over-read. Put both ends of the usable
+// pages against inaccessible pages, then test a copy flush with either end.
+class GuardedBuffer {
+public:
+    explicit GuardedBuffer(size_t bytes) {
+#if defined(_WIN32)
+        SYSTEM_INFO info;
+        GetSystemInfo(&info);
+        page_ = info.dwPageSize;
+#else
+        const long page = sysconf(_SC_PAGESIZE);
+        check(page > 0, bytes, 0, 0);
+        page_ = static_cast<size_t>(page);
+#endif
+        usable_ = ((bytes + page_ - 1) / page_) * page_;
+        total_ = usable_ + 2 * page_;
+#if defined(_WIN32)
+        mapping_ = static_cast<unsigned char*>(VirtualAlloc(nullptr, total_, MEM_RESERVE, PAGE_NOACCESS));
+        check(mapping_ != nullptr, bytes, 0, 0);
+        check(VirtualAlloc(mapping_ + page_, usable_, MEM_COMMIT, PAGE_READWRITE) != nullptr, bytes, 0, 0);
+#else
+        void* mapping = mmap(nullptr, total_, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        check(mapping != MAP_FAILED, bytes, 0, 0);
+        mapping_ = static_cast<unsigned char*>(mapping);
+        check(mprotect(mapping_ + page_, usable_, PROT_READ | PROT_WRITE) == 0, bytes, 0, 0);
+#endif
+    }
+    ~GuardedBuffer() {
+#if defined(_WIN32)
+        VirtualFree(mapping_, 0, MEM_RELEASE);
+#else
+        munmap(mapping_, total_);
+#endif
+    }
+    GuardedBuffer(const GuardedBuffer&) = delete;
+    GuardedBuffer& operator=(const GuardedBuffer&) = delete;
+    unsigned char* at(size_t bytes, bool end) { return mapping_ + page_ + (end ? usable_ - bytes : 0); }
+private:
+    unsigned char* mapping_ = nullptr;
+    size_t page_ = 0, usable_ = 0, total_ = 0;
+};
+
+size_t check_protected_ends() {
+    size_t cases = 0;
+    // Traverse every tail residue above the streaming threshold and both sides
+    // of the 64/128-byte loop boundaries. Small lengths also cover the fallback.
+    for (size_t n = 1; n <= 4353; ++n) {
+        if (n > 129 && n < 4095) continue;
+        GuardedBuffer source(n), destination(n);
+        for (bool source_end : {false, true}) {
+            for (bool destination_end : {false, true}) {
+                auto* s = source.at(n, source_end);
+                auto* d = destination.at(n, destination_end);
+                for (size_t i = 0; i < n; ++i) s[i] = (i * 37 + n) % 251;
+                const std::vector<unsigned char> before(s, s + n);
+                std::fill_n(d, n, kGuard);
+                strata::poly::stage_copy_streaming(d, s, n);
+                check(std::equal(before.begin(), before.end(), d) && std::equal(before.begin(), before.end(), s),
+                      n, source_end, destination_end);
+                ++cases;
+            }
+        }
+    }
+    return cases;
+}
+#endif
+} // namespace
+
+int main() {
+    constexpr std::array<size_t, 21> lengths = {
+        0, 1, 15, 16, 17, 63, 64, 65, 127, 128, 129,
+        4095, 4096, 4097, 4159, 4160, 4161, 4223, 4224, 4225, 65535
+    };
+    size_t offsets = 0;
+    for (size_t n : lengths) offsets += check_offsets(n, 1);
+    // Real expert sizes; a sparse alignment sweep keeps this host-only test fast.
+    for (size_t n : {size_t(589824), size_t(720896)}) offsets += check_offsets(n, 15);
+    size_t protected_ends = 0;
+#if defined(_WIN32) || defined(__unix__) || defined(__APPLE__)
+    protected_ends = check_protected_ends();
+#else
+    std::puts("SKIP protected-page checks: no platform implementation");
+#endif
+    std::printf("PASS %zu aligned-offset cases, %zu protected-end cases\n", offsets, protected_ends);
+    return 0;
+}
